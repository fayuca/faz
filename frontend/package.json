{
	"name": "frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint . --ext .ts",
		"preview": "vite preview",
		"codegen:api": "openapi-typescript ./openapi/openapi.json -o ./src/api/generated/api.ts",
		"codegen:api:live": "openapi-typescript http://localhost:8080/v3/api-docs -o ./openapi/openapi.json && openapi-typescript ./openapi/openapi.json -o ./src/api/generated/api.ts"
	},
	"dependencies": {
		"axios": "^1.16.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"zod": "^4.4.3",
		"zod-validation-error": "^5.0.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@eslint/js": "^10.0.1",
		"@rolldown/plugin-babel": "^0.2.3",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^24.12.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/eslint-plugin": "^8.59.4",
		"@typescript-eslint/parser": "^8.59.4",
		"@vitejs/plugin-react": "^6.0.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^10.4.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"jiti": "^2.7.0",
		"openapi-typescript": "^7.13.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.59.2",
		"vite": "^8.0.12"
	}
}
